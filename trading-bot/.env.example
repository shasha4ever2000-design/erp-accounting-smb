# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file stays on your computer. It is never uploaded.

# Capital.com: Settings -> API integrations -> Generate new key
CAPITAL_API_KEY=
# The email you log in to Capital.com with
CAPITAL_IDENTIFIER=
# The password you typed when you created the API key (not your normal login password)
CAPITAL_PASSWORD=

# Telegram: token from @BotFather, and your own chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only for testing on past prices (free account at tiingo.com)
TIINGO_API_KEY=

# Second switch for REAL MONEY. Leave empty unless you really mean it.
# Real money needs BOTH: "mode: live" in config.yaml AND this exact text here:
# TRADEBOT_CONFIRM_LIVE=I_UNDERSTAND_REAL_MONEY
